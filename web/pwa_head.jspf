<%-- Shared head: viewport, PWA, mobile layer. Include right after <head> on every page. --%>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#667eea">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="ICSS">
<meta name="format-detection" content="telephone=no">
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icons/logo192.png">
<link rel="stylesheet" href="css/mobile.css?v=20261006">
<script src="scripts/mobile.js?v=20261006" defer></script>
